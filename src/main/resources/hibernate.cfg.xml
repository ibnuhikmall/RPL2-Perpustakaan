<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
  "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
  "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
  <session-factory>

    <!-- Koneksi ke database -->
    <property name="jakarta.persistence.jdbc.url">jdbc:mysql://localhost:3306/db_perpustakaan</property>
    <property name="jakarta.persistence.jdbc.user">root</property>
    <property name="jakarta.persistence.jdbc.password"></property>

    <!-- Tampilkan SQL di jendela Output (berguna untuk belajar) -->
    <property name="hibernate.show_sql">true</property>

    <!-- none = Hibernate TIDAK boleh mengubah tabel (tabel dibuat dari script SQL) -->
    <property name="hibernate.hbm2ddl.auto">none</property>

    <!-- Daftar class entity -->
    <mapping class="model.User"/>
    <mapping class="model.Buku"/>
    <mapping class="model.Anggota"/>
    <mapping class="model.Peminjaman"/>

  </session-factory>
</hibernate-configuration>
