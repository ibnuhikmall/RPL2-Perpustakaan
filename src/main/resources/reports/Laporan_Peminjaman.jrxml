<?xml version="1.0" encoding="UTF-8"?>
<!--
  Laporan_Peminjaman.jrxml
  Template laporan peminjaman buku (A4 landscape, tampilan sederhana).
  Buka di Jaspersoft Studio 7, simpan (Ctrl+S), lalu kompilasi menjadi Laporan_Peminjaman.jasper.

  Parameter : PERIODE, DICETAK_OLEH, TOTAL_DENDA
  Field     : sama dengan property class model.LaporanRow
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Laporan_Peminjaman" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="782" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30">
	<style name="Default" isDefault="true" fontName="DejaVu Sans" fontSize="10"/>

	<!-- Parameter: dikirim dari program (LaporanPrinter) -->
	<parameter name="PERIODE" class="java.lang.String"/>
	<parameter name="DICETAK_OLEH" class="java.lang.String"/>
	<parameter name="TOTAL_DENDA" class="java.lang.Integer"/>

	<!-- Field: satu per property LaporanRow (nama harus persis sama) -->
	<field name="idPinjam" class="java.lang.Integer"/>
	<field name="noAnggota" class="java.lang.String"/>
	<field name="namaAnggota" class="java.lang.String"/>
	<field name="kodeBuku" class="java.lang.String"/>
	<field name="judulBuku" class="java.lang.String"/>
	<field name="tglPinjam" class="java.lang.String"/>
	<field name="tglJatuhTempo" class="java.lang.String"/>
	<field name="tglKembali" class="java.lang.String"/>
	<field name="denda" class="java.lang.Integer"/>
	<field name="status" class="java.lang.String"/>

	<title>
		<band height="60">
			<staticText>
				<reportElement x="0" y="5" width="782" height="28"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[LAPORAN PEMINJAMAN BUKU]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="35" width="782" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA["Periode: " + $P{PERIODE}]]></textFieldExpression>
			</textField>
		</band>
	</title>

	<columnHeader>
		<band height="24">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="35" height="24" backcolor="#D9E2F3"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[No]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="35" y="0" width="150" height="24" backcolor="#D9E2F3"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Anggota]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="185" y="0" width="220" height="24" backcolor="#D9E2F3"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Judul Buku]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="405" y="0" width="80" height="24" backcolor="#D9E2F3"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Tgl Pinjam]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="485" y="0" width="80" height="24" backcolor="#D9E2F3"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Jatuh Tempo]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="565" y="0" width="80" height="24" backcolor="#D9E2F3"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Tgl Kembali]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="645" y="0" width="70" height="24" backcolor="#D9E2F3"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Denda]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="715" y="0" width="67" height="24" backcolor="#D9E2F3"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font isBold="true"/>
				</textElement>
				<text><![CDATA[Status]]></text>
			</staticText>
		</band>
	</columnHeader>

	<detail>
		<band height="22">
			<textField isBlankWhenNull="true">
				<reportElement x="0" y="0" width="35" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="35" y="0" width="150" height="22"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{namaAnggota}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="185" y="0" width="220" height="22"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{judulBuku}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="405" y="0" width="80" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{tglPinjam}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="485" y="0" width="80" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{tglJatuhTempo}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="565" y="0" width="80" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{tglKembali}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true">
				<reportElement x="645" y="0" width="70" height="22"/>
				<box leftPadding="4" rightPadding="4">
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{denda}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="715" y="0" width="67" height="22"/>
				<box>
					<pen lineWidth="0.5"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{status}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<pageFooter>
		<band height="24">
			<textField>
				<reportElement x="0" y="4" width="500" height="16"/>
				<textElement verticalAlignment="Middle">
					<font size="9" isItalic="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Dicetak oleh: " + $P{DICETAK_OLEH}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="582" y="4" width="200" height="16"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="9"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Halaman " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>

	<summary>
		<band height="36">
			<textField>
				<reportElement x="0" y="8" width="782" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font size="11" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Total Denda: Rp" + new java.text.DecimalFormat("#,##0").format($P{TOTAL_DENDA})]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
